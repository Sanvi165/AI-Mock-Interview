# Optional. Leave empty to run in demo mode (built-in questions and rule-based scoring).
GEMINI_API_KEY= your_api_key_here
GROQ_API_KEY=your_api_key_here

# Change this only if Ai says the model was not found.
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# Where the React app runs (needed for CORS).
FRONTEND_ORIGIN=http://localhost:5173

# Optional: custom database file. Default is backend/interview.db
